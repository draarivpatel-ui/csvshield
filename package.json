{
  "name": "@aarivbuildz/csvshield",
  "version": "1.0.0",
  "description": "Zero-dependency CSV/TSV formula-injection, DDE and RFC 4180 security toolkit for Node.js",
  "type": "module",
  "license": "MIT",
  "main": "./cjs/index.cjs",
  "module": "./src/index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./cjs/index.cjs"
    },
    "./core": {
      "types": "./types/index.d.ts",
      "import": "./src/core.mjs",
      "require": "./cjs/core.cjs"
    }
  },
  "bin": {
    "csvshield": "./bin/csvshield.mjs"
  },
  "files": [
    "src/",
    "cjs/",
    "types/",
    "bin/",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "GOOD_FIRST_ISSUES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node scripts/build-cjs.mjs",
    "pretest": "node scripts/build-cjs.mjs",
    "test": "node scripts/run-tests.mjs tests/*.test.mjs",
    "test:all": "npm run build && node scripts/run-tests.mjs tests/*.test.mjs"
  },
  "dependencies": {},
  "devDependencies": {},
  "keywords": [
    "csv",
    "tsv",
    "security",
    "formula-injection",
    "cwe-1236",
    "dde",
    "rfc4180",
    "zero-dependency",
    "sanitize",
    "spreadsheet"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/draarivpatel-ui/csvshield.git"
  },
  "bugs": {
    "url": "https://github.com/draarivpatel-ui/csvshield/issues"
  },
  "homepage": "https://github.com/draarivpatel-ui/csvshield#readme",
  "publishConfig": {
    "access": "public"
  }
}
